# ── Control de Caché para SPA Vite ──
<IfModule mod_headers.c>
  # index.html NUNCA debe guardarse en caché para que el navegador siempre consulte
  # la última versión del manifiesto de módulos y sus hashes actualizados.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Los archivos de assets estáticos tienen hashes únicos de contenido (p. ej. AdminDashboard-x3XenV_R.js).
  # Se pueden cachear de forma inmutable y por largo plazo en el cliente y CDN.
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Reescritura para Single Page Application (SPA) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Si un archivo de /assets/ no existe (por ejemplo, un chunk de un deploy viejo),
  # devolver 404 real en vez de entregar index.html (evita SyntaxError al evaluar HTML como JS).
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Rutas de la SPA: cualquier otra URL que no sea archivo o directorio se delega a index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
