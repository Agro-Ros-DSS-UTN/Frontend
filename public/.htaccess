# ── Control de Caché para SPA Vite ──
<IfModule mod_headers.c>
  # index.html NUNCA debe guardarse en caché para que el navegador siempre consulte
  # la última versión del manifiesto de módulos y sus hashes actualizados.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Los archivos de assets estáticos tienen hashes únicos de contenido (p. ej. AdminDashboard-x3XenV_R.js).
  # Se pueden cachear de forma inmutable y por largo plazo en el cliente y CDN.
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Cabeceras de seguridad (el API ya las envía; estas son para el sitio) ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Nadie puede mostrar el CRM dentro de otra página (clickjacking).
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Cámara, micrófono (audios de actividades) y ubicación solo para el propio sitio.
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
  # Solo HTTPS durante 30 días (se puede subir a un año cuando esté probado).
  Header always set Strict-Transport-Security "max-age=2592000" "expr=%{HTTPS} == 'on'"
  # CSP en modo "solo informe": no bloquea nada, solo avisa en la consola del navegador.
  # Cuando pase una semana sin avisos, se cambia a Content-Security-Policy.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ── Reescritura para Single Page Application (SPA) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Si un archivo de /assets/ no existe (por ejemplo, un chunk de un deploy viejo),
  # devolver 404 real en vez de entregar index.html (evita SyntaxError al evaluar HTML como JS).
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Rutas de la SPA: cualquier otra URL que no sea archivo o directorio se delega a index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
